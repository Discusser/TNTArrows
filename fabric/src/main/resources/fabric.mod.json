{
  "schemaVersion": 1,
  "id": "tntarrows",
  "version": "${version}",
  "name": "TNT Arrows",
  "description": "Adds arrows that can be mixed with TNTs for explosive effects!",
  "authors": [
    "Discusser"
  ],
  "contact": {
    "issues": "https://github.com/Discusser/TNTArrows/issues",
    "sources": "https://github.com/Discusser/TNTArrows"
  },
  "license": "MIT",
  "icon": "assets/tntarrows/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.discusser.tntarrows.fabric.TNTArrowsFabric"
    ],
    "client": [
      "io.github.discusser.tntarrows.fabric.TNTArrowsFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "architectury": ">=${architectury_version}",
    "fabric-api": "*"
  },
  "accessWidener": "tntarrows.accesswidener"
